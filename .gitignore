# ============================================================================
# Patterns are extension-only and path-agnostic on purpose: folders in this
# repo get renamed/moved (e.g. telem/ -> misc/telem/), and an anchored path
# rule silently stops matching when that happens.
# ============================================================================

# Python virtual environment
.venv/

# Qoder local IDE settings
.qoder/

# --- ANSYS / solver generated output: regenerable, routinely 100MB-1.3GB -----
*.CWR
*.HTQ
*.HTO
*.STN
*.LCN
*.clg

# Solver per-process lock files (.P00 .. .P99), appear/disappear mid-solve.
# Digit-anchored so SolidWorks *.p2m / *.p2s appearance files stay tracked.
*.P[0-9][0-9]
*.p[0-9][0-9]

# --- Archives ----------------------------------------------------------------
*.zip

# --- Telemetry exports and shards (local only) --------------------------------
*.lp
*.tsm
*.tar
*.gz

# Office / SolidWorks lock files created while a file is open
~$*
